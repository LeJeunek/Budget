# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright (tests/e2e/) — generated run artifacts, and the storageState
# files auth.setup.ts writes (real, live session cookies for the two
# e2e-test@/e2e-test-admin@lkbudget.dev accounts — never committed, mirrors
# .env* being ignored for the same "never commit a live credential" reason).
/playwright-report/
/test-results/
/tests/e2e/support/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code — machine-local permission overrides, not shared
.claude/settings.local.json
